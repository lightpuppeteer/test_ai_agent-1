; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Our Little Island"
config/description="A cozy little island of shared memories."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.98, 0.94, 0.86, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/boot_splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

Game="*res://scripts/core/game.gd"
Sound="*res://scripts/audio/sound.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path.editor="res://_shots/godot.log"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1920
window/size/window_height_override=1080
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/Nunito.ttf"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="characters"
3d_physics/layer_3="vehicles"
3d_physics/layer_4="props"

[physics]

3d/physics_engine="Jolt Physics"


common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/ssao/quality=1
environment/ssao/half_size=true
environment/ssil/quality=1
environment/ssil/half_size=true
textures/default_filters/anisotropic_filtering_level=3

[shader_globals]

curve_amount={
"type": "float",
"value": 0.0011
}
curve_origin={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
curve_dir={
"type": "vec3",
"value": Vector3(0, 0, -1)
}
player_pos={
"type": "vec3",
"value": Vector3(0, -100, 0)
}
partner_pos={
"type": "vec3",
"value": Vector3(0, -100, 0)
}
shadow_tint={
"type": "vec4",
"value": Vector4(0.42, 0.48, 0.85, 0.55)
}
